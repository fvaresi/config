[general]
accounts = Mind
maxsyncaccounts = 4

# Path to file with arbitrary Python code to be loaded
pythonfile = ~/bin/offlineimap.py

################################################## Gmail ##################################################
[Account Mind]
autorefresh = 1
postsynchook = ~/bin/offlineimap-postsync-mind
localrepository = MindLocal
remoterepository = MindRemote
synclabels = yes

[Repository MindLocal]
type = Maildir
localfolders = ~/Mail/Mind

[Repository MindRemote]
type = IMAP
auth_mechanisms = GSSAPI, CRAM-MD5, PLAIN, LOGIN
remoteuser = fvaresi@mindresearch.org
remotepasseval = get_pass("offlineimap")
remotehost = outlook.office365.com
remoteport = 993
realdelete = no

folderfilter = lambda folder: folder not in ['Calendar', 'Calendar/Birthdays', 'Calendar/Sub Folder 1', 'Calendar/Sub Folder 2', 'Calendar/United States holidays', 'Contacts', 'Contacts/Sub Folder 1', 'Contacts/Sub Folder 2', 'Contacts/Skype for Business Contacts', 'Deleted Items', 'Drafts', 'Journal', 'Junk Email', 'Notes', 'Outbox', 'Sync Issues', 'Sync Issues/Conflicts', 'Sync Issues/Local Failures', 'Sync Issues/Server Failures', 'Tasks', 'Tasks/Sub Folder 1', 'Tasks/Sub Folder 2']

sslcacertfile = /etc/ssl/certs/ca-certificates.crt